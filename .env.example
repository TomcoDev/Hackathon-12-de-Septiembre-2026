# Copiar a .env y completar. El .env está en .gitignore: NUNCA se sube.

# OpenRouter: gateway a muchos modelos con una sola key. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Verificar el ID exacto en https://openrouter.ai/models antes de usar
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI directo, si el hackathon entrega créditos
OPENAI_API_KEY=

# Exa: búsqueda para agentes. https://dashboard.exa.ai
EXA_API_KEY=

# Trigger.dev: jobs en background, cron, webhooks. https://cloud.trigger.dev
TRIGGER_SECRET_KEY=

# Telegram: crear el bot con @BotFather y pegar el token
TELEGRAM_BOT_TOKEN=

# Backend local
PORT=3000
