# Copiar a .env y completar. El .env está en .gitignore: NUNCA se sube.

# OpenRouter: gateway a muchos modelos con una sola key. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Verificar el ID exacto en https://openrouter.ai/models antes de usar
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI directo. Si esta key está, el agente usa la Responses API y OpenRouter
# queda como plan B automático, sin tocar una línea de código.
OPENAI_API_KEY=
# gpt-5.6-luna es el barato y alcanza para el detector. terra y sol son más caros.
# OJO: la familia gpt-5.x rechaza temperature y top_p; src/llm.ts ya no los manda.
OPENAI_MODEL=gpt-5.6-luna

# Exa: búsqueda para agentes. https://dashboard.exa.ai
EXA_API_KEY=

# Trigger.dev: la espera diferida que hace que el agente vuelva solo al grupo.
# La key sale del dashboard y empieza con tr_dev_sk_. https://cloud.trigger.dev
TRIGGER_SECRET_KEY=
# Ref del proyecto, formato proj_xxxx. Lo completa `npm run trigger:init`.
TRIGGER_PROJECT_REF=

# ── Calibración del agente ───────────────────────────────────────────────────
# Cuál de los tres patrones detecta: tarea-sin-dueno | decision-no-anotada |
# deriva-definiciones
PATRON=tarea-sin-dueno
# Minutos que espera antes de volver a preguntar. Bajarlo a 1 para grabar el video.
SEGUIMIENTO_MINUTOS=30
# Umbral de confianza para intervenir. Calibrar con `npm run replay`, no a ojo.
UMBRAL=0.8
# Guardas: mensajes mínimos entre chequeos del modelo y entre intervenciones.
MIN_CHEQUEO=3
MIN_INTERVENCION=10

# Telegram: crear el bot con @BotFather y pegar el token
TELEGRAM_BOT_TOKEN=

# Backend local
PORT=3000
